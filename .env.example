# ==============================================================================
# KaizenTrace & TeamFlow Workspace Environment Configuration
# ==============================================================================

# --- MongoDB Atlas Persistent Store ---
# Configure your MongoDB Atlas connection string here.
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/kaizentrace?retryWrites=true&w=majority
# If left empty, KaizenTrace and TeamFlow gracefully fallback to an isolated local in-memory Mongo database.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kaizentrace?retryWrites=true&w=majority

# --- KaizenTrace Server Settings ---
KAIZENTRACE_PORT=5050
CORS_ORIGIN=http://localhost:5180
LOG_LEVEL=info

# --- TeamFlow Demo Project Location ---
# Relative or absolute path to the TeamFlow repository folder
TEAMFLOW_PATH=./teamflow

# --- TeamFlow Application Ports ---
TEAMFLOW_PORT=5000
TEAMFLOW_FRONTEND_PORT=5173
