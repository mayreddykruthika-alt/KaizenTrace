# TeamFlow Application Environment Configuration
# Copy this file to backend/.env and configure your values

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/teamflow?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Background Job Settings
ENABLE_DEADLINE_JOB=true
DEADLINE_JOB_INTERVAL_MS=60000

# KaizenTrace Demo Failure Injection Flags (Disabled by default)
TEST_FAIL_DEADLINE_JOB=false
TEST_FAIL_TASK_UPDATE=false
TEST_DISABLE_PERMISSIONS=false
